{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitAny": true,
    "paths": {
      "@shared/*": ["./apps/web/src/shared/*", "./apps/mobile/src/shared/*"],
      "@utils/*": ["./apps/web/src/utils/*"],
      "@platform/*": ["./apps/mobile/src/platform/*"],
      "@dosiq/core": ["./packages/core/src"],
      "@dosiq/core/*": ["./packages/core/src/*"],
      "@dosiq/shared-data": ["./packages/shared-data/src"],
      "@dosiq/shared-data/*": ["./packages/shared-data/src/*"]
    }
  },
  "include": [
    "packages/core/src/types/**/*",
    "packages/core/src/repositories/**/*",
    "packages/core/src/services/**/*",
    "packages/core/src/schemas/**/*",
    "server/notifications/**/*",
    "apps/web/src/shared/hooks/**/*",
    "apps/mobile/src/shared/hooks/**/*"
  ]
}
