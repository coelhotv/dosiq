{
  "version": 2,
  "buildCommand": "cd apps/web && npx vite build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "devCommand": "cd apps/web && npx vite --port $PORT",
  "functions": {
    "api/notify.ts": { "maxDuration": 60 },
    "api/ops.ts": { "maxDuration": 60 },
    "api/telegram.ts": { "maxDuration": 10 },
    "api/generate-doses.ts": { "maxDuration": 60 },
    "api/report.ts": { "maxDuration": 30, "memory": 2048, "includeFiles": "node_modules/@sparticuz/chromium/bin/**" }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(badges|screens|app-icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/([^/]+\\.(?:png|svg|ico|jpg|webp))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(service-worker.js|registerSW.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/dlq/:id/retry",
      "destination": "/api/admin?resource=dlq&action=retry&id=:id"
    },
    {
      "source": "/api/dlq/:id/discard",
      "destination": "/api/admin?resource=dlq&action=discard&id=:id"
    },
    {
      "source": "/api/dlq",
      "destination": "/api/admin?resource=dlq"
    },
    {
      "source": "/api/feedbacks/:id/resolve",
      "destination": "/api/admin?resource=feedbacks&action=resolve&id=:id"
    },
    {
      "source": "/api/feedbacks",
      "destination": "/api/admin?resource=feedbacks"
    },
    {
      "source": "/api/admin/nudges/:id",
      "destination": "/api/admin?resource=nudges&id=:id"
    },
    {
      "source": "/api/admin/nudges",
      "destination": "/api/admin?resource=nudges"
    },
    {
      "source": "/api/admin/prune/:action",
      "destination": "/api/admin?resource=prune&action=:action"
    },
    {
      "source": "/api/admin/prune",
      "destination": "/api/admin?resource=prune&action=list"
    },
    {
      "source": "/api/ops/:job",
      "destination": "/api/ops?job=:job"
    },
    {
      "source": "/api/health/notifications",
      "destination": "/api/admin?resource=health&scope=notifications"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/telegram"
    },
    {
      "source": "/api/notify",
      "destination": "/api/notify"
    },
    {
      "source": "/api/generate-doses",
      "destination": "/api/generate-doses"
    },
    {
      "source": "/api/users/beta-signup",
      "destination": "/api/users?action=beta-signup"
    },
    {
      "source": "/api/report",
      "destination": "/api/report"
    },
    {
      "source": "/api/chatbot",
      "destination": "/api/chatbot"
    },
    {
      "source": "/api/users/register-webpush",
      "destination": "/api/users?action=register-webpush"
    },
    {
      "source": "/((?!api/|.*\\.[^/]+$).*)",
      "destination": "/index"
    }
  ]
}
