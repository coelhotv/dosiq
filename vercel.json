{
  "version": 2,
  "buildCommand": "cd apps/web && npx vite build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "devCommand": "cd apps/web && npx vite --port $PORT",
  "functions": {
    "api/notify.ts": { "maxDuration": 60 },
    "api/telegram.ts": { "maxDuration": 10 },
    "api/generate-doses.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    {
      "source": "/api/dlq/:id/retry",
      "destination": "/api/admin.ts?resource=dlq&action=retry&id=:id"
    },
    {
      "source": "/api/dlq/:id/discard",
      "destination": "/api/admin.ts?resource=dlq&action=discard&id=:id"
    },
    {
      "source": "/api/dlq",
      "destination": "/api/admin.ts?resource=dlq"
    },
    {
      "source": "/api/feedbacks/:id/resolve",
      "destination": "/api/admin.ts?resource=feedbacks&action=resolve&id=:id"
    },
    {
      "source": "/api/feedbacks",
      "destination": "/api/admin.ts?resource=feedbacks"
    },
    {
      "source": "/api/admin/nudges/:id",
      "destination": "/api/admin.ts?resource=nudges&id=:id"
    },
    {
      "source": "/api/admin/nudges",
      "destination": "/api/admin.ts?resource=nudges"
    },
    {
      "source": "/api/health/notifications",
      "destination": "/api/admin.ts?resource=health&scope=notifications"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/telegram.ts"
    },
    {
      "source": "/api/notify",
      "destination": "/api/notify.ts"
    },
    {
      "source": "/api/generate-doses",
      "destination": "/api/generate-doses.ts"
    },
    {
      "source": "/api/users/beta-signup",
      "destination": "/api/users.ts?action=beta-signup"
    },

    {
      "source": "/api/share",
      "destination": "/api/share.ts"
    },
    {
      "source": "/api/chatbot",
      "destination": "/api/chatbot.ts"
    },
    {
      "source": "/api/users/register-webpush",
      "destination": "/api/users.ts?action=register-webpush"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
