{
  "name": "@dosiq/core",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "node": "./dist/schemas/index.js",
      "default": "./src/schemas/index.ts"
    },
    "./schemas/*": "./src/schemas/*.ts",
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "node": "./dist/utils/index.js",
      "default": "./src/utils/index.ts"
    },
    "./utils/*": "./src/utils/*.ts",
    "./protocols-utils": "./src/protocols-utils/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts src/schemas/index.ts src/utils/index.ts --bundle --format=esm --platform=node --packages=external --outdir=dist --entry-names=[dir]/[name] --log-level=warning && tsc -p tsconfig.declarations.json && node scripts/fix-dts-extensions.mjs",
    "prepare": "npm run build"
  }
}
