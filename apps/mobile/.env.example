# Variáveis públicas do app mobile
# Copie para .env.local e preencha com seus valores
# RE-004: EXPO_PUBLIC_* são públicas e ficam no bundle — NUNCA colocar segredos aqui

# URL do projeto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Chave anônima pública do Supabase (pode ficar no bundle)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Ambiente do app (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# Observabilidade (ADR-090). Ambas são chaves PÚBLICAS de client — podem ficar no bundle.
# Sem elas configuradas, Sentry e PostHog viram no-op silencioso (o app sobe normal).
# DSN público do projeto Sentry (crash reporting)
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oNNNN.ingest.us.sentry.io/NNNN
# Project API key do PostHog (analytics de produto)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxx
# Host PostHog — US (US-Virginia): app brasil-only, backbone bra/us > bra/eu (ADR-090)
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --------------------------------------------------------------------------
# Segredos NÃO devem usar EXPO_PUBLIC_* — usar `eas secret:create` para:
#   - credenciais de submit Apple/Google
#   - tokens internos de integração
#   - SENTRY_AUTH_TOKEN (upload de sourcemap no build) + SENTRY_ORG / SENTRY_PROJECT
#
# Build local sem esses três: o build phase "Upload Debug Symbols to Sentry" FALHA e derruba o
# xcodebuild (código 65). Por isso o .env local deve trazer:
#   SENTRY_DISABLE_AUTO_UPLOAD=true
# (o perfil `development` do eas.json já faz isso; `production` usa SENTRY_ALLOW_FAILURE=true para
# que uma falha de upload de sourcemap nunca derrube um build de release).
# --------------------------------------------------------------------------
