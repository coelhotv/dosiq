ios/
android/
credentials/

# @bacons/apple-targets — gerados no prebuild a partir de targets/*/expo-target.config.js
# (a fonte versionada é o expo-target.config.js + os .swift; estes são derivados)
targets/**/Info.plist
targets/**/generated.entitlements

# Dependencies
node_modules/

# Expo
.expo/
dist/

# Local env — NUNCA commitar (contêm credenciais sensíveis)
.env
.env.local
.env.development
.env.preview
.env.production

# Firebase credentials (nunca commitar — contêm chaves privadas)
google-services*.json
GoogleService-Info*.plist
credentials.json
*.jks
