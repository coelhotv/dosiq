# Expo generated native directories (managed workflow)
# Regenerated via: npx expo prebuild
ios/
android/
credentials/

# @bacons/apple-targets — gerados no prebuild a partir de targets/*/expo-target.config.js
# (a fonte versionada é o expo-target.config.js + os .swift; estes são derivados)
targets/**/Info.plist
targets/**/generated.entitlements

# Dependencies
node_modules/

# Expo
.expo/
dist/

# Local env — NUNCA commitar (contêm credenciais sensíveis)
.env
.env.local
.env.development
.env.preview
.env.production

# Firebase credentials (nunca commitar — contêm chaves privadas)
google-services*.json
GoogleService-Info*.plist
credentials.json
*.jks

# 🔴 Code signing do expo-updates (ADR-083 / spec 051-A, PO-SEC-1)
# A chave PRIVADA assina todo `eas update` e NUNCA entra no git — comprometê-la = poder
# entregar código arbitrário a 100% da base instalada, sem passar por loja.
# Mora só no Mac Mini + backup em gestor de senhas (ver §1.4 do GUIA_OTA_EAS_UPDATE.md).
# O certificado PÚBLICO (certs/certificate.pem) É versionado de propósito: precisa ser
# embutido no binário pelo build pra que o cliente valide a assinatura.
certs/private-key.pem
certs/*private*

