# Supabase Configuration
# You'll get these values from your Supabase project dashboard
SUPABASE_URL=your-project-url-here

VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Chat ID do Telegram do admin — MENSAGERIA apenas (para onde mandar mensagem).
# NÃO é credencial de autorização: ver ADMIN_USER_ID abaixo e ADR-091 (D10).
ADMIN_CHAT_ID=seu-chat-id-do-telegram-aqui
VITE_ADMIN_CHAT_ID=seu-chat-id-do-telegram-aqui

# 🔴 CREDENCIAL DE AUTORIZAÇÃO — o `auth.users.id` (uuid) do admin.
# É o que `verifyAdminAccess` (server/utils/auth.ts) compara com o uid devolvido por
# `supabase.auth.getUser()` para liberar /api/admin (ADR-091 D10 · spec 051-A · RC-SEC-2 S-6).
#
# ⚠️ NÃO REMOVER por parecer sem uso. Até a spec 051-A ela é órfã (o DLQ Digest usa
# SYSTEM_USER_ID hardcoded, não esta var) — o comentário antigo dizia "DLQ Digest" e estava errado.
# Depois da 051-A, ausente ⇒ TODO acesso admin é NEGADO (fail-closed por desenho).
# Obter com: SELECT id FROM auth.users WHERE email = '<email do admin>';
ADMIN_USER_ID=uuid-do-admin-em-auth-users-aqui

# External Cron Secret (for cron-job.org)
CRON_SECRET=create-a-random-secret-key-here

VERCEL_TOKEN=your-vercel-token-here

VERCEL_GITHUB_ACTIONS_SECRET=your-vercel-github-actions-secret-here

BLOB_READ_WRITE_TOKEN=your-blob-read-write-token-here

GITHUB_TOKEN=your-github-token-here